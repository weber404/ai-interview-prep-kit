# Port the Express server listens on.
PORT=5000

# ---------------------------------------------------------------------------
# LLM provider configuration (Step 3 — requirement extraction).
# Placeholders only. Never commit a real key.
#
# LLM_PROVIDER : which provider implementation to use. Supported: gemini
# LLM_API_KEY  : provider API key. Without it, /api/requirements/extract
#                returns LLM_NOT_CONFIGURED rather than fabricated data.
# LLM_MODEL    : model id. Defaults to gemini-1.5-flash when unset.
# LLM_TIMEOUT_MS : per-request timeout in milliseconds. Defaults to 30000.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=30000
